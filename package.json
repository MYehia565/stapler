{
  "name": "stapler",
  "version": "1.3.1",
  "description": "BYOK adapter for Paperclip: connect up to 16 OpenAI-compatible LLM providers with your own API keys",
  "license": "MIT",
  "type": "module",
  "author": "Stapler contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYehia565/stapler.git"
  },
  "bugs": {
    "url": "https://github.com/MYehia565/stapler/issues"
  },
  "homepage": "https://github.com/MYehia565/stapler#readme",
  "keywords": [
    "paperclip",
    "paperclip-adapter",
    "byok",
    "bring-your-own-key",
    "llm",
    "llm-provider",
    "openai-compatible",
    "ai-agents",
    "agent-adapter",
    "model-routing",
    "multi-provider",
    "openrouter",
    "groq",
    "deepseek",
    "mistral",
    "ollama",
    "litellm",
    "mcp",
    "stapler"
  ],
  "engines": {
    "node": ">=20"
  },
  "paperclip": {
    "adapterUiParser": "1.4.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui-parser": "./dist/ui-parser.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
    "verify:build": "npm run build && tsc -p tsconfig.verify.json",
    "verify:e2e": "npm run verify:build && node dist-verify/scripts/verify-e2e.js",
    "verify:runtime": "npm run verify:build && node dist-verify/scripts/verify-runtime.js"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.722.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0"
  }
}
